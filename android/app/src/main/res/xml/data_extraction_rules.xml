<?xml version="1.0" encoding="utf-8"?>
<!-- The only local state is the folder permission, which cannot be restored on another device anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
